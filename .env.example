# 可选外部服务；P0 导入和默认测试不使用凭据。
DEEPSEEK_API_KEY=invalid-example
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=invalid-example
# 新会话默认总流程优先；FULL_QUALITY 恢复出锅/人工优先。已绑定会话保持原策略。
SMART_COOKING_SCHEDULING_STRATEGY=FT_KITCHEN
# 可选求解线程上限1至8；Render FT新会话默认4，初排/小菜单/人工阶段使用1。
# SMART_COOKING_SOLVER_SEARCH_WORKERS=4
