    "diagnostic_total_budget_ms": {
      "default": 2000,
      "exclusiveMinimum": 0,
      "maximum": 1152921504606846976,
      "title": "Diagnostic Total Budget Ms",
      "type": "integer"
    },
    "diagnostic_search_workers": {
      "const": 1,
      "default": 1,
      "title": "Diagnostic Search Workers",
      "type": "integer"
    },
    "max_core_shrink_checks": {
      "default": 6,
      "maximum": 1152921504606846976,
      "minimum": 0,
      "title": "Max Core Shrink Checks",
      "type": "integer"
    }
