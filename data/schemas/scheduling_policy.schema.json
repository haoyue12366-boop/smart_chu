      "const": 1,
      "default": 1,
      "title": "Concurrent Planning Jobs",
      "type": "integer"
    },
    "solver_worker_processes": {
      "const": 1,
      "default": 1,
      "title": "Solver Worker Processes",
      "type": "integer"
    },
    "max_solver_search_workers": {
      "default": 4,
      "exclusiveMinimum": 0,
      "maximum": 1152921504606846976,
      "title": "Max Solver Search Workers",
      "type": "integer"
    },
    "sqlite_busy_timeout_ms": {
      "default": 100,
      "exclusiveMinimum": 0,
      "maximum": 1152921504606846976,
      "title": "Sqlite Busy Timeout Ms",
      "type": "integer"
    },
    "sqlite_max_write_retries": {
      "default": 2,
      "maximum": 1152921504606846976,
      "minimum": 0,
      "title": "Sqlite Max Write Retries",
      "type": "integer"
