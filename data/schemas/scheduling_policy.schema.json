    "duration_data_version": {
      "default": "nominal-v1",
      "minLength": 1,
      "pattern": "\\S",
      "title": "Duration Data Version",
      "type": "string"
    },
    "duration_buffer_basis_points": {
      "default": 1500,
      "maximum": 1152921504606846976,
      "minimum": 0,
      "title": "Duration Buffer Basis Points",
      "type": "integer"
    },
    "initial_budget": {
      "$ref": "#/$defs/BudgetSpec",
      "default": {
        "total_ms": 4200,
        "greedy_ms": 150,
        "solver_ms": 3000,
        "publication_reserve_ms": 400
      }
    },
    "replan_budget": {
      "$ref": "#/$defs/BudgetSpec",
      "default": {
        "total_ms": 2400,
        "greedy_ms": 100,
        "solver_ms": 1500,
        "publication_reserve_ms": 300
      }
    },
    "objective": {
      "$ref": "#/$defs/ObjectiveSpec",
      "default": {
        "stages": [
          "MAKESPAN",
          "SPREAD",
          "HUMAN_BUSY",
          "STABILITY"
        ],
        "spread_target_sec": 240,
        "rest_gap_sec": 60,
        "makespan_extra_basis_points": 500,
        "makespan_extra_cap_sec": 120
      }
    },
    "greedy_search": {
