        "max_gap_checks_per_candidate": 32,
        "rollback_depth": 3,
        "rollback_attempts": 8,
        "max_standalone_restarts": 1
      }
    },
    "max_exact_human_phases": {
      "default": 120,
      "exclusiveMinimum": 0,
      "maximum": 1152921504606846976,
      "title": "Max Exact Human Phases",
      "type": "integer"
    },
    "minimum_exact_human_budget_ms": {
      "default": 100,
      "exclusiveMinimum": 0,
      "maximum": 1152921504606846976,
      "title": "Minimum Exact Human Budget Ms",
      "type": "integer"
    },
    "model_soft_limits": {
      "$ref": "#/$defs/ModelSize",
      "default": {
        "total_variables": 6000,
        "boolean_variables": 4000,
        "optional_intervals": 1500,
        "total_constraints": 20000,
        "sequence_arcs": 8000
      }
