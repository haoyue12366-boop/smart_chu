{
  "$defs": {
    "BudgetSpec": {
      "additionalProperties": false,
      "properties": {
        "total_ms": {
          "exclusiveMinimum": 0,
          "maximum": 1152921504606846976,
          "title": "Total Ms",
          "type": "integer"
        },
        "greedy_ms": {
          "exclusiveMinimum": 0,
          "maximum": 1152921504606846976,
          "title": "Greedy Ms",
          "type": "integer"
        },
        "solver_ms": {
          "exclusiveMinimum": 0,
          "maximum": 1152921504606846976,
          "title": "Solver Ms",
          "type": "integer"
        },
        "publication_reserve_ms": {
          "exclusiveMinimum": 0,
          "maximum": 1152921504606846976,
          "title": "Publication Reserve Ms",
          "type": "integer"
        }
      },
      "required": [
        "total_ms",
        "greedy_ms",
        "solver_ms",
        "publication_reserve_ms"
      ],
      "title": "BudgetSpec",
      "type": "object"
    },
    "GreedySearchLimits": {
      "additionalProperties": false,
      "properties": {
        "max_variants": {
          "default": 3,
          "exclusiveMinimum": 0,
          "maximum": 1152921504606846976,
          "title": "Max Variants",
          "type": "integer"
        },
        "max_placements_per_iteration": {
          "default": 24,
          "exclusiveMinimum": 0,
          "maximum": 1152921504606846976,
          "title": "Max Placements Per Iteration",
          "type": "integer"
        },
        "max_gap_checks_per_candidate": {
          "default": 32,
          "exclusiveMinimum": 0,
          "maximum": 1152921504606846976,
          "title": "Max Gap Checks Per Candidate",
          "type": "integer"
        },
        "rollback_depth": {
          "default": 3,
          "maximum": 1152921504606846976,
          "minimum": 0,
          "title": "Rollback Depth",
          "type": "integer"
        },
        "rollback_attempts": {
          "default": 8,
          "maximum": 1152921504606846976,
          "minimum": 0,
          "title": "Rollback Attempts",
          "type": "integer"
        },
        "max_standalone_restarts": {
          "default": 1,
          "maximum": 1152921504606846976,
          "minimum": 0,
          "title": "Max Standalone Restarts",
          "type": "integer"
        }
      },
      "title": "GreedySearchLimits",
      "type": "object"
    },
    "ModelSize": {
      "additionalProperties": false,
      "properties": {
        "total_variables": {
          "default": 0,
          "maximum": 1152921504606846976,
          "minimum": 0,
          "title": "Total Variables",
          "type": "integer"
        },
        "boolean_variables": {
          "default": 0,
          "maximum": 1152921504606846976,
          "minimum": 0,
          "title": "Boolean Variables",
          "type": "integer"
        },
        "optional_intervals": {
          "default": 0,
          "maximum": 1152921504606846976,
          "minimum": 0,
          "title": "Optional Intervals",
          "type": "integer"
        },
        "total_constraints": {
          "default": 0,
          "maximum": 1152921504606846976,
          "minimum": 0,
          "title": "Total Constraints",
          "type": "integer"
        },
        "sequence_arcs": {
          "default": 0,
          "maximum": 1152921504606846976,
          "minimum": 0,
          "title": "Sequence Arcs",
          "type": "integer"
        }
      },
      "title": "ModelSize",
      "type": "object"
    },
    "ObjectiveSpec": {
      "additionalProperties": false,
      "properties": {
        "spread_basis": {
          "default": "WORKFLOW_FINISH",
          "enum": [
            "WORKFLOW_FINISH",
            "COOKING_FINISH"
          ],
          "title": "Spread Basis",
          "type": "string"
        },
        "stages": {
          "default": [
            "MAKESPAN",
            "SPREAD",
            "HUMAN_BUSY",
            "STABILITY"
          ],
          "items": {
            "enum": [
              "MAKESPAN",
              "SPREAD",
              "TOTAL_HUMAN_WORK",
              "HUMAN_BUSY",
              "STABILITY"
            ],
            "type": "string"
          },
          "title": "Stages",
          "type": "array"
        },
        "spread_target_sec": {
          "default": 240,
          "maximum": 1152921504606846976,
          "minimum": 0,
          "title": "Spread Target Sec",
          "type": "integer"
        },
        "rest_gap_sec": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 1152921504606846976,
          "title": "Rest Gap Sec",
          "type": "integer"
        },
        "makespan_extra_basis_points": {
          "default": 500,
          "maximum": 1152921504606846976,
          "minimum": 0,
          "title": "Makespan Extra Basis Points",
          "type": "integer"
        },
        "makespan_extra_cap_sec": {
          "default": 120,
          "maximum": 1152921504606846976,
          "minimum": 0,
          "title": "Makespan Extra Cap Sec",
          "type": "integer"
        }
      },
      "title": "ObjectiveSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "policy_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Policy Version",
      "type": "string"
    },
    "time_grid_sec": {
      "default": 1,
      "exclusiveMinimum": 0,
      "maximum": 1152921504606846976,
      "title": "Time Grid Sec",
      "type": "integer"
    },
    "minute_output_mode": {
      "default": "DECIMAL",
      "enum": [
        "DECIMAL",
        "INTEGER"
      ],
      "title": "Minute Output Mode",
      "type": "string"
    },
    "human_count": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Human Count",
      "type": "integer"
    },
    "human_resource_id": {
      "const": "human_1",
      "default": "human_1",
      "title": "Human Resource Id",
      "type": "string"
    },
    "burner_ids": {
      "default": [
        "burner_1",
        "burner_2"
      ],
      "items": {
        "enum": [
          "burner_1",
          "burner_2"
        ],
        "type": "string"
      },
      "title": "Burner Ids",
      "type": "array"
    },
    "max_nonstandalone_per_requirement": {
      "default": 12,
      "exclusiveMinimum": 0,
      "maximum": 1152921504606846976,
      "title": "Max Nonstandalone Per Requirement",
      "type": "integer"
    },
    "max_nonstandalone_per_problem": {
      "default": 256,
      "exclusiveMinimum": 0,
      "maximum": 1152921504606846976,
      "title": "Max Nonstandalone Per Problem",
      "type": "integer"
    },
    "preserve_mandatory_recipe_batches": {
      "const": true,
      "default": true,
      "title": "Preserve Mandatory Recipe Batches",
      "type": "boolean"
    },
    "preserve_all_standalone_candidates": {
      "const": true,
      "default": true,
      "title": "Preserve All Standalone Candidates",
      "type": "boolean"
    },
    "shared_prep": {
      "default": false,
      "title": "Shared Prep",
      "type": "boolean"
    },
    "allow_delegated_shared_estimates": {
      "default": false,
      "title": "Allow Delegated Shared Estimates",
      "type": "boolean"
    },
    "strict_together_batch": {
      "default": false,
      "title": "Strict Together Batch",
      "type": "boolean"
    },
    "generic_common_start_batch": {
      "const": false,
      "default": false,
      "title": "Generic Common Start Batch",
      "type": "boolean"
    },
    "generic_common_finish_batch": {
      "const": false,
      "default": false,
      "title": "Generic Common Finish Batch",
      "type": "boolean"
    },
    "enable_certified_non_equivalent_pruning": {
      "default": false,
      "title": "Enable Certified Non Equivalent Pruning",
      "type": "boolean"
    },
    "equivalence_deduplication": {
      "default": true,
      "title": "Equivalence Deduplication",
      "type": "boolean"
    },
    "graph_bound_preprocessing": {
      "default": true,
      "title": "Graph Bound Preprocessing",
      "type": "boolean"
    },
    "duration_policy_id": {
      "default": "NOMINAL",
